# Database
DATABASE_URL="postgresql://alkhadim_user:alkhadim_pass@localhost:5432/alkhadim_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production-min-32-chars"

# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,https://alkhadim.ae"

# Email (optional — if SMTP_HOST is unset, mail is logged instead of sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@alkhadim.ae

# Per-module sender identities. Each module sends from <user>@MAIL_DOMAIN by
# default; override any single mailbox with MAIL_<USER>, e.g. MAIL_CAREERS.
MAIL_DOMAIN=alkhadim.ae
# MAIL_CAREERS=careers@alkhadim.ae
# MAIL_HR=hr@alkhadim.ae
# MAIL_BILLING=billing@alkhadim.ae

# Email scheduler poll interval (ms) and CV ID prefix
EMAIL_POLL_MS=60000
CV_ID_PREFIX=AK-CV

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
# Base URL of the web app, used to build links inside emails (invites, share links)
WEB_URL=http://localhost:3000
