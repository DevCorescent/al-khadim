# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/alkhadim_db"

# Auth — long random strings, different per environment
JWT_SECRET="change-me-min-32-chars"
JWT_REFRESH_SECRET="change-me-min-32-chars"

# Origin of this app (the API is served from it under /api).
# Leave empty to call the API on the same origin (recommended, incl. Vercel).
# Baked into the browser bundle at build time — never set it to localhost in production.
NEXT_PUBLIC_API_URL=
# Base URL used to build links inside emails (invites, share links)
WEB_URL=http://localhost:3000

# File storage: Cloudflare R2. Used once ALL FOUR are set; otherwise files are
# kept in web/uploads/. Copy existing files over once with:
#   node scripts/migrate-uploads-to-r2.mjs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI CV parsing ("true" to enable). Uses the provider/key/model saved in
# Admin → Settings → AI Assistant.
CV_AI_PARSING=false

# Optional fallbacks — normally configured by the Super Admin in the admin panel
# (Settings → Email / Settings → AI Assistant). Only needed if nothing is saved there.
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS=
# MAIL_DOMAIN=alkhadim.ae
# AI_PROVIDER=gemini|groq|openai|openrouter / OPENAI_API_KEY=

# Candidate CV ID prefix
CV_ID_PREFIX=AK-CV

# Seed overrides (npm run db:seed)
# SEED_ADMIN_EMAIL= / SEED_ADMIN_PASSWORD=
# SEED_DEMO_DATA=false
