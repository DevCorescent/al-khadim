# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/alkhadim_db"

# Auth — long random strings, different per environment
JWT_SECRET="change-me-min-32-chars"
JWT_REFRESH_SECRET="change-me-min-32-chars"

# Origin of this app (the API is served from it under /api).
# Leave empty to call the API on the same origin (recommended, incl. Vercel).
# Baked into the browser bundle at build time — never set it to localhost in production.
NEXT_PUBLIC_API_URL=
# Base URL used to build links inside emails (invites, share links)
WEB_URL=http://localhost:3000

# Email (optional — if SMTP_HOST is unset, mail is logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Per-module sender identities: <module>@MAIL_DOMAIN, override one with MAIL_<USER>
MAIL_DOMAIN=alkhadim.ae
EMAIL_POLL_MS=60000

# AI assistant (optional). Leave OPENAI_BASE_URL unset for OpenAI itself, or
# point it at a compatible provider (e.g. Groq: https://api.groq.com/openai/v1
# with OPENAI_MODEL=openai/gpt-oss-120b — Groq's free-tier models as of 2026-09;
# llama-3.3-70b-versatile / llama-3.1-8b-instant were deprecated on their free
# tier on 2026-08-16).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Candidate CV ID prefix
CV_ID_PREFIX=AK-CV

# Seed overrides (npm run db:seed)
# SEED_ADMIN_EMAIL= / SEED_ADMIN_PASSWORD=
# SEED_DEMO_DATA=false
