// Al Khadim platform — database schema for the Next.js backend.
// Ported from api/prisma/schema.prisma (the Express backend the frontend was built against),
// so field names/enums match what the existing UI sends and expects.
// Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECRUITER
  HR
  ACCOUNTANT
  VIEWER
}

enum CandidateStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  JOINED
  REJECTED
  ON_HOLD
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
  FILLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
  RESIGNED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}

enum DocumentType {
  PASSPORT
  VISA
  OFFER_LETTER
  CONTRACT
  CV
  CERTIFICATE
  ID_PROOF
  OTHER
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  OTHER
}

enum ClientUserRole {
  COMPANY_ADMIN
  COMPANY_MEMBER
}

enum ShareMethod {
  PORTAL
  EMAIL
  BOTH
}

enum ShareStatus {
  SENT
  VIEWED
  DOWNLOADED
  SHORTLISTED
  REJECTED
  INTERVIEW_REQUESTED
  INTERVIEW_SCHEDULED
  WITHDRAWN
}

enum ProfileShareEventType {
  CREATED
  EMAIL_SENT
  RESENT
  VIEWED
  DOWNLOADED
  SHORTLISTED
  REJECTED
  INTERVIEW_REQUESTED
  INTERVIEW_SCHEDULED
  WITHDRAWN
}

enum ProfileShareActorType {
  STAFF
  CLIENT_USER
  ANONYMOUS_TOKEN
  SYSTEM
}

enum InterviewMode {
  ONLINE
  OFFLINE
}

enum TrackingVisibility {
  PRIVATE
  PUBLIC
}

enum EmailTemplateCategory {
  TRANSACTIONAL
  CAMPAIGN
}

enum RecipientType {
  CANDIDATES
  EMPLOYEES
  CLIENTS
  CLIENT_USERS
  USERS
}

enum CampaignTargetMode {
  FILTER
  GROUP
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         UserRole  @default(VIEWER)
  customRole   String?
  permissions  Json?
  phone        String?
  avatar       String?
  department   String?
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs          AuditLog[]
  followUps          FollowUp[]
  sentProfileShares  ProfileShare[]      @relation("SentProfileShares")
  invitedClientUsers ClientUser[]        @relation("StaffInvitedClientUsers")
  candidateTrackings CandidateTracking[]
  requestedDocuments DocumentRequest[]   @relation("RequestedDocuments")
  verifiedDocuments  DocumentRequest[]   @relation("VerifiedDocuments")
  approvedClients    Client[]            @relation("ClientApprovedBy")
  publishedJobs      Job[]               @relation("JobPublishedBy")
  dealsOwned         Deal[]              @relation("DealOwner")
  activitiesLogged   Activity[]          @relation("ActivityCreatedBy")
  expensesApproved   Expense[]           @relation("ExpenseApprovedBy")
  chatConversations  ChatConversation[]

  @@map("users")
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6366f1")
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_roles")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6366f1")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates Candidate[]
  jobs       Job[]

  @@map("categories")
}

model Industry {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?
  color            String   @default("#6366f1")
  order            Int      @default(0)
  hasTracking      Boolean  @default(false)
  trackingSections Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  candidates      Candidate[]
  clients         Client[]
  jobs            Job[]
  trackingRecords CandidateTracking[]

  @@map("industries")
}

enum ClientStatus {
  PENDING
  APPROVED
  REJECTED
}

model Client {
  id               String       @id @default(cuid())
  companyName      String
  contactPerson    String
  email            String
  phone            String
  altPhone         String?
  industry         String?
  industryId       String?
  industryRef      Industry?    @relation(fields: [industryId], references: [id])
  country          String       @default("UAE")
  city             String?
  address          String?
  website          String?
  notes            String?
  isActive         Boolean      @default(true)
  source           String?
  status           ClientStatus @default(APPROVED)
  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?        @relation("ClientApprovedBy", fields: [approvedByUserId], references: [id])
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tags String[] @default([])

  jobs          Job[]
  followUps     FollowUp[]
  invoices      Invoice[]
  enquiries     ClientEnquiry[]
  users         ClientUser[]
  profileShares ProfileShare[]
  deals         Deal[]
  activities    Activity[]

  @@map("clients")
}

enum JobSource {
  STAFF
  COMPANY_REQUEST
}

model Job {
  id                      String      @id @default(cuid())
  title                   String
  clientId                String
  client                  Client      @relation(fields: [clientId], references: [id])
  description             String?
  requirements            String?
  location                String?
  country                 String      @default("UAE")
  salaryMin               Float?
  salaryMax               Float?
  currency                String      @default("AED")
  positionsCount          Int         @default(1)
  filledCount             Int         @default(0)
  status                  JobStatus   @default(OPEN)
  jobType                 String?
  experience              String?
  deadline                DateTime?
  source                  JobSource   @default(STAFF)
  requestedByClientUserId String?
  requestedByClientUser   ClientUser? @relation("RequestedJobs", fields: [requestedByClientUserId], references: [id])
  isPublished             Boolean     @default(true)
  publishedAt             DateTime?
  publishedByUserId       String?
  publishedBy             User?       @relation("JobPublishedBy", fields: [publishedByUserId], references: [id])
  categoryId              String?
  category                Category?   @relation(fields: [categoryId], references: [id])
  industryId              String?
  industry                Industry?   @relation(fields: [industryId], references: [id])
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  applications  CandidateJob[]
  interviews    Interview[]
  profileShares ProfileShare[]
  deals         Deal[]

  @@map("jobs")
}

model Candidate {
  id              String          @id @default(cuid())
  cvId            String?         @unique
  firstName       String
  lastName        String
  email           String          @unique
  phone           String
  altPhone        String?
  nationality     String?
  passportNo      String?
  passportExpiry  DateTime?
  visaStatus      String?
  currentLocation String?
  currentSalary   Float?
  expectedSalary  Float?
  currency        String          @default("AED")
  experience      Int?
  skills          String[]
  education       String?
  languages       String[]
  status          CandidateStatus @default(NEW)
  source          String?
  notes           String?
  cvPath          String?
  photo           String?
  // Portal fields
  headline        String?
  summary         String?
  linkedIn        String?
  portfolio       String?
  introVideoUrl   String?
  isPublic        Boolean         @default(false)
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  industryId      String?
  industry        Industry?       @relation(fields: [industryId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applications     CandidateJob[]
  interviews       Interview[]
  documents        Document[]
  followUps        FollowUp[]
  account          CandidateAccount?
  editHistory      CandidateEditHistory[]
  profileRequests  ProfileRequest[]
  profileShares    ProfileShare[]
  tracking         CandidateTracking[]
  documentRequests DocumentRequest[]

  @@map("candidates")
}

model CandidateAccount {
  id           String    @id @default(cuid())
  candidateId  String    @unique
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  password     String
  refreshToken String?
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("candidate_accounts")
}

model CandidateJob {
  id          String          @id @default(cuid())
  candidateId String
  candidate   Candidate       @relation(fields: [candidateId], references: [id])
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id])
  status      CandidateStatus @default(NEW)
  appliedAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  notes       String?

  @@unique([candidateId, jobId])
  @@map("candidate_jobs")
}

model Interview {
  id             String        @id @default(cuid())
  candidateId    String
  candidate      Candidate     @relation(fields: [candidateId], references: [id])
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id])
  scheduledAt    DateTime
  type           String        @default("VIDEO")
  mode           InterviewMode @default(ONLINE)
  meetLink       String?
  location       String?
  interviewers   String[]
  status         String        @default("SCHEDULED")
  feedback       String?
  rating         Int?
  notes          String?
  profileShareId String?
  profileShare   ProfileShare? @relation(fields: [profileShareId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("interviews")
}

model Employee {
  id              String         @id @default(cuid())
  employeeId      String         @unique
  firstName       String
  lastName        String
  email           String         @unique
  phone           String
  nationality     String?
  passportNo      String?
  passportExpiry  DateTime?
  visaNo          String?
  visaExpiry      DateTime?
  emiratesId      String?
  emiratesExpiry  DateTime?
  designation     String
  department      String?
  joiningDate     DateTime
  terminationDate DateTime?
  status          EmployeeStatus @default(ACTIVE)
  basicSalary     Float
  currency        String         @default("AED")
  bankName        String?
  bankAccount     String?
  iban            String?
  address         String?
  emergencyName   String?
  emergencyPhone  String?
  notes           String?
  photo           String?
  clientId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  attendances  Attendance[]
  leaves       Leave[]
  payrolls     Payroll[]
  documents    Document[]
  outsourcings Outsourcing[]

  @@map("employees")
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  overtime    Float?
  status      String    @default("PRESENT")
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([employeeId, date])
  @@map("attendance")
}

model Leave {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     LeaveStatus @default(PENDING)
  reason     String?
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("leaves")
}

model Payroll {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  month         Int
  year          Int
  basicSalary   Float
  allowances    Float         @default(0)
  overtime      Float         @default(0)
  deductions    Float         @default(0)
  grossSalary   Float
  netSalary     Float
  currency      String        @default("AED")
  status        PayrollStatus @default(DRAFT)
  paymentDate   DateTime?
  paymentMethod String?
  notes         String?
  payslipPath   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accountTransactions AccountTransaction[]

  @@unique([employeeId, month, year])
  @@map("payroll")
}

model Outsourcing {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  clientName    String
  startDate     DateTime
  endDate       DateTime?
  designation   String
  salary        Float
  currency      String    @default("AED")
  visaStatus    String?
  accommodation String?
  insurance     Boolean   @default(false)
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("outsourcing")
}

model Document {
  id          String       @id @default(cuid())
  type        DocumentType
  title       String
  filePath    String
  fileSize    Int?
  mimeType    String?
  expiryDate  DateTime?
  employeeId  String?
  employee    Employee?    @relation(fields: [employeeId], references: [id])
  candidateId String?
  candidate   Candidate?   @relation(fields: [candidateId], references: [id])
  notes       String?
  uploadedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("documents")
}

model FollowUp {
  id          String       @id @default(cuid())
  type        FollowUpType @default(CALL)
  subject     String
  notes       String?
  dueDate     DateTime
  completedAt DateTime?
  isCompleted Boolean      @default(false)
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  candidateId String?
  candidate   Candidate?   @relation(fields: [candidateId], references: [id])
  assignedTo  String?
  user        User?        @relation(fields: [assignedTo], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("follow_ups")
}

model Invoice {
  id                  String               @id @default(cuid())
  invoiceNo           String               @unique
  docType             String               @default("INVOICE") // INVOICE | PROFORMA_INVOICE | QUOTATION
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id])
  // Amounts
  subtotal            Float                @default(0)
  discount            Float                @default(0)
  discountType        String               @default("FIXED") // FIXED | PERCENT
  tax                 Float                @default(0)
  taxRate             Float                @default(5)
  amount              Float                @default(0) // kept for compatibility
  totalAmount         Float                @default(0)
  currency            String               @default("AED")
  // Status & dates
  status              String               @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | CANCELLED | ACCEPTED | REJECTED
  issueDate           DateTime             @default(now())
  dueDate             DateTime?
  paidDate            DateTime?
  validUntil          DateTime?
  // Billing
  billingName         String?
  billingAddress      String?
  billingEmail        String?
  billingPhone        String?
  // Content
  subject             String?
  description         String?
  terms               String?
  notes               String?
  // Sender / From details
  fromName            String?
  fromAddress         String?
  fromEmail           String?
  fromPhone           String?
  fromTaxNo           String? // VAT/GST/TRN/EIN etc
  fromRegNo           String? // Company registration number
  // Tax customisation
  taxLabel            String               @default("VAT") // VAT | GST | HST | Sales Tax | Tax | None
  // Payment
  paymentMethod       String               @default("BANK_TRANSFER") // BANK_TRANSFER | CHEQUE | CASH | ONLINE | CRYPTO | OTHER
  paymentRef          String?
  // Bank details
  bankName            String?
  bankAccount         String?
  bankIBAN            String?
  bankSwift           String?
  bankRoutingNo       String?
  bankSortCode        String?
  // Design / appearance
  template            String               @default("classic") // classic | modern | minimal | corporate
  primaryColor        String               @default("#6366f1") @map("primary_color")
  accentColor         String               @default("#ffffff") @map("accent_color")
  fontFamily          String               @default("helvetica") @map("font_family")
  logoText            String?              @map("logo_text")
  logoShape           String               @default("rounded") @map("logo_shape")
  tableStyle          String               @default("striped") @map("table_style")
  watermark           String?
  watermarkOpacity    Int                  @default(12) @map("watermark_opacity")
  showHeader          Boolean              @default(true) @map("show_header")
  showFooter          Boolean              @default(true) @map("show_footer")
  showSignature       Boolean              @default(false) @map("show_signature")
  footerText          String?              @map("footer_text")
  // Relations
  items               InvoiceItem[]
  accountTransactions AccountTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Float    @default(1)
  unit        String?
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("invoice_items")
}

model ClientEnquiry {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  designation String?
  email       String
  phone       String
  service     String?
  message     String?
  status      String   @default("NEW")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal Deal?

  @@map("client_enquiries")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
  STAGE_CHANGE
  SYSTEM
}

model Deal {
  id                String         @id @default(cuid())
  title             String
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  jobId             String?
  job               Job?           @relation(fields: [jobId], references: [id])
  value             Float          @default(0)
  currency          String         @default("AED")
  stage             DealStage      @default(LEAD)
  probability       Int            @default(10)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  lossReason        String?
  source            String?
  ownerId           String?
  owner             User?          @relation("DealOwner", fields: [ownerId], references: [id])
  enquiryId         String?        @unique
  enquiry           ClientEnquiry? @relation(fields: [enquiryId], references: [id])
  createdBy         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  activities Activity[]

  @@index([clientId])
  @@index([stage])
  @@map("deals")
}

model Activity {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId        String?
  deal          Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  type          ActivityType @default(NOTE)
  content       String
  metadata      Json?
  createdBy     String?
  createdByUser User?        @relation("ActivityCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())

  @@index([clientId])
  @@index([dealId])
  @@map("activities")
}

model CandidateRegistration {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String   @unique
  phone           String
  nationality     String?
  experience      String?
  skills          String?
  education       String?
  headline        String?
  summary         String?
  linkedIn        String?
  currentLocation String?
  languages       String?
  cvPath          String?
  photo           String?
  password        String?
  parsedData      Json?
  status          String   @default("NEW")
  notes           String?
  convertedTo     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("candidate_registrations")
}

enum OtpPurpose {
  CANDIDATE_REGISTRATION
  COMPANY_REGISTRATION
}

model OtpCode {
  id           String     @id @default(cuid())
  email        String
  codeHash     String
  purpose      OtpPurpose
  expiresAt    DateTime
  consumedAt   DateTime?
  ticketUsedAt DateTime?
  attempts     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

model ProfileRequest {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requesterName String
  companyName   String
  email         String
  phone         String
  position      String?
  message       String?
  status        String    @default("NEW")
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("profile_requests")
}

model CandidateEditHistory {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  editedBy    String // "candidate" | "admin" | "system"
  editorName  String?
  editorId    String?
  changes     Json
  reason      String?
  createdAt   DateTime  @default(now())

  @@map("candidate_edit_history")
}

model ClientUser {
  id                    String         @id @default(cuid())
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                  String
  email                 String         @unique
  password              String?
  role                  ClientUserRole @default(COMPANY_MEMBER)
  isActive              Boolean        @default(true)
  refreshToken          String?
  lastLogin             DateTime?
  inviteToken           String?        @unique
  inviteExpiresAt       DateTime?
  acceptedAt            DateTime?
  invitedByStaffId      String?
  invitedByStaff        User?          @relation("StaffInvitedClientUsers", fields: [invitedByStaffId], references: [id])
  invitedByClientUserId String?
  invitedByClientUser   ClientUser?    @relation("ClientUserInvites", fields: [invitedByClientUserId], references: [id])
  invitedTeammates      ClientUser[]   @relation("ClientUserInvites")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  respondedShares ProfileShare[] @relation("ClientUserResponses")
  requestedJobs   Job[]          @relation("RequestedJobs")

  @@map("client_users")
}

model ProfileShare {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id])

  sharedFields      String[]
  sharedDocumentIds String[]
  snapshotData      Json

  method         ShareMethod @default(PORTAL)
  accessToken    String?     @unique
  tokenExpiresAt DateTime?

  status  ShareStatus @default(SENT)
  message String?
  notes   String?

  sentByUserId String
  sentByUser   User     @relation("SentProfileShares", fields: [sentByUserId], references: [id])
  sentAt       DateTime @default(now())

  respondedByClientUserId String?
  respondedByClientUser   ClientUser? @relation("ClientUserResponses", fields: [respondedByClientUserId], references: [id])
  respondedAt             DateTime?

  withdrawnAt       DateTime?
  withdrawnByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events     ProfileShareEvent[]
  interviews Interview[]

  @@index([candidateId])
  @@index([clientId])
  @@index([jobId])
  @@index([status])
  @@map("profile_shares")
}

model ProfileShareEvent {
  id        String                @id @default(cuid())
  shareId   String
  share     ProfileShare          @relation(fields: [shareId], references: [id], onDelete: Cascade)
  eventType ProfileShareEventType
  actorType ProfileShareActorType
  actorId   String?
  actorName String?
  metadata  Json?
  createdAt DateTime              @default(now())

  @@index([shareId])
  @@map("profile_share_events")
}

model CandidateTracking {
  id                 String             @id @default(cuid())
  candidateId        String
  candidate          Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  industryId         String
  industry           Industry           @relation(fields: [industryId], references: [id])
  visibility         TrackingVisibility @default(PRIVATE)
  visibleToCandidate Boolean            @default(false)
  visibleToCompany   Boolean            @default(false)
  data               Json               @default("{}")
  updatedByUserId    String?
  updatedByUser      User?              @relation(fields: [updatedByUserId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documentRequests   DocumentRequest[]

  @@unique([candidateId, industryId])
  @@map("candidate_tracking")
}

enum DocumentRequestStatus {
  REQUESTED
  UPLOADED
  VERIFIED
  REJECTED
}

model DocumentRequest {
  id          String             @id @default(cuid())
  candidateId String
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  trackingId  String?
  tracking    CandidateTracking? @relation(fields: [trackingId], references: [id], onDelete: SetNull)

  title       String
  description String?
  status      DocumentRequestStatus @default(REQUESTED)

  filePath String?
  fileSize Int?
  mimeType String?

  visibleToCompany Boolean @default(false)

  requestedByUserId String
  requestedByUser   User     @relation("RequestedDocuments", fields: [requestedByUserId], references: [id])
  requestedAt       DateTime @default(now())

  uploadedAt DateTime?

  verifiedByUserId String?
  verifiedByUser   User?     @relation("VerifiedDocuments", fields: [verifiedByUserId], references: [id])
  verifiedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([trackingId])
  @@map("document_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  module    String
  recordId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ScheduledEmail {
  id            String         @id @default(cuid())
  module        String         @default("system") // which module identity sends it
  to            String
  cc            String?
  bcc           String?
  subject       String
  html          String?
  text          String?
  sendAt        DateTime // when it should go out
  status        String         @default("PENDING") // PENDING | SENT | FAILED | CANCELLED
  attempts      Int            @default(0)
  error         String?
  sentAt        DateTime?
  createdBy     String?
  campaignId    String?
  campaign      EmailCampaign? @relation(fields: [campaignId], references: [id])
  recipientId   String? // id of the source Candidate/Employee/Client/ClientUser/User row
  recipientName String? // snapshot, so history reads fine even if the source record changes later
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, sendAt])
  @@index([campaignId])
  @@map("scheduled_emails")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  OFFICE_SUPPLIES
  MARKETING
  TRAVEL
  PROFESSIONAL_FEES
  MAINTENANCE
  INSURANCE
  IT_SOFTWARE
  BANK_CHARGES
  TAXES
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum AccountType {
  BANK
  CASH
  PETTY_CASH
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  INVOICE_PAYMENT
  EXPENSE_PAYMENT
  PAYROLL_PAYMENT
  ADJUSTMENT
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Expense {
  id                 String          @id @default(cuid())
  expenseNo          String          @unique
  category           ExpenseCategory
  vendor             String?
  description        String
  amount             Float
  taxAmount          Float           @default(0)
  totalAmount        Float
  currency           String          @default("AED")
  date               DateTime
  dueDate            DateTime?
  paidDate           DateTime?
  status             ExpenseStatus   @default(DRAFT)
  paymentMethod      String?
  paymentRef         String?
  isRecurring        Boolean         @default(false)
  recurrenceInterval String?
  receiptPath        String?
  notes              String?
  accountId          String?
  account            BankAccount?    @relation(fields: [accountId], references: [id])
  approvedByUserId   String?
  approvedBy         User?           @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  transactions AccountTransaction[]

  @@index([category])
  @@index([status])
  @@index([date])
  @@map("expenses")
}

model BankAccount {
  id             String      @id @default(cuid())
  name           String
  type           AccountType @default(BANK)
  bankName       String?
  accountNumber  String?
  iban           String?
  currency       String      @default("AED")
  openingBalance Float       @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions AccountTransaction[]
  expenses     Expense[]

  @@map("bank_accounts")
}

model AccountTransaction {
  id               String          @id @default(cuid())
  accountId        String
  account          BankAccount     @relation(fields: [accountId], references: [id])
  type             TransactionType
  amount           Float // signed: positive = inflow, negative = outflow
  description      String?
  relatedInvoiceId String?
  relatedInvoice   Invoice?        @relation(fields: [relatedInvoiceId], references: [id])
  relatedExpenseId String?
  relatedExpense   Expense?        @relation(fields: [relatedExpenseId], references: [id])
  relatedPayrollId String?
  relatedPayroll   Payroll?        @relation(fields: [relatedPayrollId], references: [id])
  date             DateTime        @default(now())
  createdBy        String?
  createdAt        DateTime        @default(now())

  @@index([accountId])
  @@index([date])
  @@map("account_transactions")
}

model Budget {
  id        String          @id @default(cuid())
  category  ExpenseCategory
  period    BudgetPeriod    @default(MONTHLY)
  year      Int
  month     Int?
  quarter   Int?
  amount    Float
  currency  String          @default("AED")
  notes     String?
  createdBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("budgets")
}

model EmailTemplate {
  id            String                @id @default(cuid())
  slug          String                @unique
  name          String
  category      EmailTemplateCategory @default(TRANSACTIONAL)
  recipientType RecipientType?
  module        String                @default("system")
  subject       String
  html          String
  design        Json?
  mergeTags     Json?
  isActive      Boolean               @default(true)
  version       Int                   @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  campaigns EmailCampaign[]

  @@index([category])
  @@map("email_templates")
}

model EmailGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   EmailGroupMember[]
  campaigns EmailCampaign[]

  @@map("email_groups")
}

model EmailGroupMember {
  id            String        @id @default(cuid())
  groupId       String
  group         EmailGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipientType RecipientType
  recipientId   String
  name          String
  email         String
  addedAt       DateTime      @default(now())

  @@unique([groupId, recipientType, recipientId])
  @@index([groupId])
  @@map("email_group_members")
}

model EmailCampaign {
  id               String             @id @default(cuid())
  name             String
  templateId       String?
  template         EmailTemplate?     @relation(fields: [templateId], references: [id])
  subject          String
  html             String
  design           Json?
  module           String             @default("system")
  targetMode       CampaignTargetMode @default(FILTER)
  recipientType    RecipientType?
  filters          Json?
  groupId          String?
  group            EmailGroup?        @relation(fields: [groupId], references: [id])
  customRecipients Json?
  status           CampaignStatus     @default(DRAFT)
  scheduledAt      DateTime?
  sentAt           DateTime?
  totalRecipients  Int                @default(0)
  sentCount        Int                @default(0)
  failedCount      Int                @default(0)
  createdBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  scheduledEmails ScheduledEmail[]

  @@index([status, scheduledAt])
  @@map("email_campaigns")
}

// ── AI Assistant: persisted chat history (public guidance bot + role-scoped internal analyst) ──

enum ChatSurface {
  PUBLIC
  ADMIN
}

enum ChatMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

model ChatConversation {
  id            String      @id @default(cuid())
  surface       ChatSurface
  userId        String? // null for PUBLIC (anonymous visitor)
  user          User?       @relation(fields: [userId], references: [id])
  sessionId     String? // anonymous browser session key (PUBLIC only)
  title         String? // derived from the first user message
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([surface, sessionId])
  @@map("chat_conversations")
}

model ChatMessage {
  id               String           @id @default(cuid())
  conversationId   String
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             ChatMessageRole
  content          String? // prose shown as the chat bubble
  toolCalls        Json? // assistant row: OpenAI tool_calls requested, verbatim
  toolCallId       String? // tool row: which tool_call this responds to
  toolName         String? // tool row: function invoked
  structured       Json? // { summary, table?: { columns, rows } } — render/export source of truth, never derived from `content`
  model            String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
